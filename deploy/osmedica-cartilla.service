[Unit]
Description=OSMEDICA Cartilla API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dash/OsmedicaCartilla
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dash/OsmedicaCartilla/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8012
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
